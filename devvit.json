{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "play-clack",
  "sourceIgnores": [
    ".internal/**",
    "e2e/**"
  ],
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "enable": true
    },
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create a new Clack post",
        "description": "Publish today's Clack daily marble puzzle post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Spawn Specific Clack Day",
        "description": "Publish a chosen Clack island as a new post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/spawn-day"
      }
    ]
  },
  "forms": {
    "spawnDayForm": "/internal/menu/spawn-day-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "play_clack_dev"
  }
}
