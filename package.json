{
  "private": true,
  "name": "play-clack",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run type-check && npm run lint && npm test && npm run build",
    "type-check": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "dev:local": "vite --config vite.local.config.ts",
    "dev": "devvit playtest",
    "upload": "npm run check && npx devvit upload",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.6",
    "@devvit/web": "0.15.6",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.6",
    "hono": "4.13.17",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.187.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.7",
    "vitest": "^5.1.2"
  }
}
